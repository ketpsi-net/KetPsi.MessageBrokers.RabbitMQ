<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source generator for KetPsi.MessageBrokers.RabbitMQ. Rewrites AddSubscriber&lt;THandler&gt; calls, through interceptors, into AddSubscriber&lt;THandler, TMessage&gt; with the message type taken from the handler's IRabbitMqHandler&lt;T&gt;. Shipped inside the library's package as an analyzer.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KetPsi.MessageBrokers.RabbitMQ.Generators.Tests" />
  </ItemGroup>

</Project>
